{
  "name": "tiny-factory-rush",
  "version": "0.5.0",
  "private": true,
  "description": "Casual idle factory game MVP for CrazyGames validation",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "skill:new": "node scripts/create-skill.mjs",
    "xr:harness": "node tools/xr-harness/evaluate.mjs",
    "gates": "node scripts/gates.mjs",
    "gates:quick": "node scripts/gates.mjs --level quick",
    "loop": "node scripts/agent-loop.mjs",
    "loop:selftest": "node scripts/loop-selftest.mjs",
    "tasks": "node scripts/tasks.mjs",
    "review:packet": "node scripts/review-packet.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "xr:fov": "node tools/xr-harness/fov-check.mjs",
    "quest:ready": "node scripts/quest-ready.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "playwright": "^1.51.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  }
}
